# Salin file ini menjadi .env lalu isi nilainya.

# --- Koneksi ke master-bot (signal_broadcaster.py) ---
MASTER_HOST=127.0.0.1      # IP/host mesin master (ganti bila beda mesin)
MASTER_PORT=9009           # samakan dgn BROADCAST_PORT di master
RECONNECT_MIN=2
RECONNECT_MAX=30
SOCKET_TIMEOUT=45          # putus & reconnect bila diam > N detik (heartbeat 15s)

# --- MT5 (eksekusi order, Windows + MetaTrader 5) ---
MT5_SYMBOL=XAUUSD          # sesuaikan nama simbol di broker client
MT5_LOGIN=                 # opsional (login otomatis)
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                  # opsional: C:\Program Files\...\terminal64.exe

# --- Parameter eksekusi ---
TRADE_LOT=0.1
TRADE_MAGIC=640064
TRADE_DEVIATION=20
MAX_OPEN_POSITIONS=1
TRADE_FILLING=auto         # auto | ioc | fok | return

# Sumber harga TP/SL: 0 = hitung ulang dari jarak pakai tick client (default, aman)
#                     1 = pakai harga absolut dari master apa adanya
USE_MASTER_PRICES=0

# Paksa simulasi (tidak buka order). Otomatis aktif bila MT5 tak tersedia.
DRY_RUN=0

# Abaikan sinyal id sama yg diterima ulang dalam N detik (anti-duplikat).
DEDUP_TTL=3600

# --- Notifikasi Telegram (opsional; saat order dieksekusi/gagal) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
